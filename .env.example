# ── LLM Orchestration (Doc #6 §2) ─────────────────────────────────────────
# Required — app refuses to start if these are missing.
LLM_FAST_API_KEY=
LLM_REASONING_API_KEY=
LLM_PROVIDER=

# ── Database (Doc #6 §2) ──────────────────────────────────────────────────
# SQLite for local/demo; PostgreSQL for production.
DATABASE_URL=sqlite:///./crewlinai.db

# ── Auth (Doc #6 §2) ──────────────────────────────────────────────────────
# Required — app refuses to start if JWT_SECRET_KEY is missing.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── App environment (Doc #6 §2) ───────────────────────────────────────────
ENVIRONMENT=development

# ── CrewLink-specific overrides (optional) ────────────────────────────────
DEBUG=true
CHROMA_PERSIST_DIR=./chroma_data
VENUE_CODE=founders_field
SIMULATOR_AUTH_TOKEN=sim-service-token-change-in-prod
